<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="clientSide.controllers.ContributionModalController"
      spacing="24"
      style="-fx-background-color: white; -fx-padding: 32;"
      stylesheets="@../dashboard/dashboard.css"
      prefWidth="420">

    <!-- Header -->
    <VBox spacing="8">
        <Label fx:id="itemNameLabel" text="Contribute to Item" 
            style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label fx:id="walletBalanceLabel" text="My Wallet Balance: $500.00" 
            style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label fx:id="remainingCostLabel" text="Remaining Cost: $100.00" 
            style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 13px;"/>
    </VBox>

    <!-- Amount Input Section -->
    <VBox spacing="16">
        <Label text="Amount" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
        
        <!-- Text Field with better styling -->
        <TextField fx:id="amountField" text="0" promptText="Enter amount..."
            style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 16px;"/>
        
        <!-- Slider with labels -->
        <VBox spacing="6">
            <Slider fx:id="amountSlider" styleClass="contribution-slider" style="-fx-cursor: hand;"/>
            <HBox>
                <Label text="0" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="maxLabel" text="Max: 0" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" minWidth="80"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
         <Button fx:id="confirmBtn" text="Confirm Contribution" onAction="#handleConfirm"
             style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>
