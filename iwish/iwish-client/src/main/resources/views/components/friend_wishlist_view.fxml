<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="clientSide.controllers.FriendWishlistController"
      spacing="24"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: #f8fafc;"
      stylesheets="@../dashboard/dashboard.css">

    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <!-- Header -->
    <VBox spacing="8">
         <Label fx:id="friendNameLabel" text="Friend's Wishlist" 
             style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
         <Label text="View items and help make wishes come true" 
             style="-fx-text-fill: #64748b; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Content Grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
        <GridPane fx:id="wishlistGrid" hgap="24" vgap="24">
             <!-- Items populated by controller -->
        </GridPane>
    </ScrollPane>

</VBox>
