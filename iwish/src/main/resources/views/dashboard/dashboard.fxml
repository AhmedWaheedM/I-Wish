<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="clientSide.controllers.DashboardController"
    stylesheets="@dashboard.css">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="I-Wish" styleClass="logo-label" />

            <!-- User Info -->
            <VBox styleClass="user-profile">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="A"
                        style="-fx-text-fill: white; -fx-background-color: #3b82f6; -fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-alignment: CENTER; -fx-font-weight: bold;" />
                    <VBox>
                        <Label text="Ahmed" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                        <Label text="ahmed" style="-fx-text-fill: #718096; -fx-font-size: 12px;" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Wallet -->
            <VBox styleClass="wallet-card">
                <Label text="Wallet Balance" styleClass="wallet-text" />
                <Label text="500.00" styleClass="wallet-amount" />
            </VBox>

            <Region prefHeight="30" />

            <!-- Navigation -->
            <Button text="My Wishlist" styleClass="nav-button, active" maxWidth="Infinity" />
            <Button text="Friends List" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="Friend Requests" styleClass="nav-button" maxWidth="Infinity" />
            <Button text="Notifications" styleClass="nav-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Logout" styleClass="nav-button" maxWidth="Infinity">
                <VBox.margin>
                    <Insets bottom="20" />
                </VBox.margin>
            </Button>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <ScrollPane fitToWidth="true"
            style="-fx-background: #f4f6f8; -fx-background-color: transparent;">
            <VBox styleClass="main-content">
                <Label text="My Wishlist" styleClass="page-title" />
                <Label text="Manage your items and track contributions from friends"
                    styleClass="section-subtitle" />

                <GridPane fx:id="itemsGrid" hgap="20" vgap="20">
                    <!-- Items will be added by controller -->
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Right Sidebar -->
    <right>
        <VBox styleClass="activity-sidebar">
            <Label text="Recent Activity" styleClass="page-title" style="-fx-font-size: 18px;" />
            <Label text="Latest updates from your network" styleClass="section-subtitle"
                style="-fx-font-size: 12px;" />

            <VBox fx:id="activityList" spacing="15">
                <!-- Activities will be added by controller -->
            </VBox>
        </VBox>
    </right>

</BorderPane>