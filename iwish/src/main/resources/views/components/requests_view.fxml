<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="clientSide.controllers.RequestsController"
      spacing="24"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: -fx-main-bg;"
      stylesheets="@../dashboard/dashboard.css">

    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <!-- Header -->
    <VBox spacing="8">
         <Label text="Friend Requests" styleClass="text-h3" style="-fx-font-size: 24px;"/>
         <Label text="People who want to connect with you" styleClass="text-muted"/>
    </VBox>

    <!-- Content -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
        <VBox fx:id="requestsListContainer" spacing="12">
             <!-- Populated by Controller -->
        </VBox>
    </ScrollPane>

</VBox>
