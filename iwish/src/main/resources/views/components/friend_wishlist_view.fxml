<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="clientSide.controllers.FriendWishlistController"
      spacing="24"
      prefWidth="800" prefHeight="600"
      style="-fx-background-color: -fx-main-bg;"
      stylesheets="@../dashboard/dashboard.css">

    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <!-- Header -->
    <VBox spacing="8">
         <HBox alignment="CENTER_LEFT" spacing="12">
             <!-- Back arrow icon could go here if implemented -->
             <Label fx:id="friendNameLabel" text="Friend's Wishlist" styleClass="text-h3" style="-fx-font-size: 24px;"/>
         </HBox>
         <Label text="View items and help make wishes come true" styleClass="text-muted"/>
    </VBox>

    <!-- Grid -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
        <GridPane fx:id="wishlistGrid" hgap="24" vgap="24">
             <!-- Populated by Controller -->
        </GridPane>
    </ScrollPane>

</VBox>
